{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managepro",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",

  // Access を経由しない入口(workers.dev)を閉じる
  "workers_dev": false,
  "preview_urls": false,
  // yukkebee.com が Cloudflare の DNS 管理下にある前提
  "routes": [{ "pattern": "managepro.yukkebee.com", "custom_domain": true }],

  // 画面(Vue)のビルド成果物。/api/* だけ Worker が先に処理する
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "managepro-db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },

  // ログを有効化(AI の出力が崩れたときの調整に使う: `npx wrangler tail`)
  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "REPLACE_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUD_TAG",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "AI_DAILY_USER_LIMIT": "15",
    "AI_DAILY_GLOBAL_LIMIT": "40",
    "WORK_START": "09:00",
    "WORK_END": "22:00",
    "DEFAULT_TZ": "Asia/Tokyo"
  }
}
