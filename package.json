{
  "name": "managepro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.web.json",
    "db:migrate:local": "wrangler d1 migrations apply managepro-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply managepro-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && vite build"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vue-tsc": "^3.0.0"
  }
}